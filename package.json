{
  "name": "new-nex",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b packages/protocol packages/core packages/daemon && tsc -p packages/client/tsconfig.json && tsc -p packages/shell/tsconfig.json",
    "test": "vitest run && pnpm --filter @nex/shell test",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
