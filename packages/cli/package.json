{
    "name": "@kelpi/cli",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "The `kelpi` CLI: a TypeScript port of the shipped Swift binary, daemon-aware.",
    "exports": {
        ".": "./src/index.ts"
    },
    "types": "./src/index.ts",
    "bin": {
        "kelpi": "./dist/kelpi.js",
        "nex": "./dist/kelpi.js"
    },
    "scripts": {
        "build": "node scripts/bundle.mjs",
        "watch": "node scripts/bundle.mjs --watch",
        "typecheck": "tsc -b .",
        "test": "vitest run --root ../.. --project node packages/cli"
    },
    "dependencies": {
        "@kelpi/protocol": "workspace:*"
    },
    "devDependencies": {
        "esbuild": "^0.28.2"
    }
}
