{
  "name": "@kelpi/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store/index.ts",
    "./git": "./src/git/index.ts",
    "./lifecycle": "./src/lifecycle/index.ts",
    "./boot/port": "./src/boot/port.ts"
  },
  "types": "./src/index.ts",
  "bin": {
    "kelpid": "./dist/kelpid.js"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "watch": "node scripts/bundle.mjs --watch",
    "start": "node scripts/bundle.mjs && node dist/kelpid.js start --foreground",
    "kelpid": "node scripts/bundle.mjs && node dist/kelpid.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@kelpi/core": "workspace:*",
    "@kelpi/protocol": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "hono": "^4.13.3",
    "markdown-it": "^15.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2"
  }
}
