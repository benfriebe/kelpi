+/// Clear a selection if either endpoint belongs to a row about to be discarded.
+/// Other tracked pins retain PageList's existing cursor/viewport semantics.
+pub fn clearSelectionOnRow(self: *Screen, y: size.CellCountInt) void {
+    const sel = self.selection orelse return;
+    for ([_]Pin{ sel.start(), sel.end() }) |p| {
+        const pt = self.pages.pointFromPin(.active, p) orelse continue;
+        if (pt.coord().y == y) {
+            self.clearSelection();
+            return;
+        }
+    }
+}
+
+/// Follow text moved by insertLines/deleteLines, whose cell copies do not move
+/// PageList pins. Clear the entire selection when either endpoint is discarded.
+pub fn scrollSelection(
+    self: *Screen,
+    top: size.CellCountInt,
+    bottom: size.CellCountInt,
+    left: size.CellCountInt,
+    right: size.CellCountInt,
+    delta: isize,
+) void {
+    const sel = if (self.selection) |*v| v else return;
+    if (sel.start().garbage or sel.end().garbage) {
+        self.clearSelection();
+        return;
+    }
+    for ([_]*Pin{ sel.startPtr(), sel.endPtr() }) |p| {
+        const pt = self.pages.pointFromPin(.active, p.*) orelse continue;
+        const c = pt.coord();
+        if (c.y < top or c.y > bottom or c.x < left or c.x > right) continue;
+        const y = @as(isize, @intCast(c.y)) + delta;
+        if (y < top or y > bottom) {
+            self.clearSelection();
+            return;
+        }
+        p.* = self.pages.pin(.{ .active = .{ .x = c.x, .y = @intCast(y) } }).?;
+    }
+}
