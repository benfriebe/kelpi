exports[`the Settings window on a desktop > renders byte-identical markup on a deep-linked tab too 1`] = `"<div data-testid="settings-backdrop" class="absolute inset-0 z-50 flex items-center justify-center" style="background: rgba(0, 0, 0, 0.62);"><div data-testid="settings-window" role="dialog" aria-modal="true" aria-label="Settings" class="flex h-[min(620px,90%)] w-[clamp(560px,92%,880px)] flex-col overflow-hidden rounded-[10px]" style="background: var(--kelpi-surface, #101013); border: 1px solid var(--kelpi-border, #24242B); box-shadow: 0 24px 70px rgba(0,0,0,0.5); color: var(--kelpi-fg, #E6E6EA);"><div data-testid="settings-toolbar" class="flex shrink-0 items-center gap-2 border-b px-3 py-2" style="background: var(--kelpi-header-bg, #13131A); border-color: var(--kelpi-border, #24242B);"><span class="text-[12px] font-semibold" style="color: var(--kelpi-fg, #E6E6EA);">Settings</span><span class="text-[11px]" style="color: var(--kelpi-fg-tertiary, #6A6A72);">Workspaces</span><span class="ml-auto"><button type="button" data-hovered="false" data-testid="settings-close" class="whitespace-nowrap rounded border px-2 py-1 text-center text-[11px] transition-colors duration-100 disabled:opacity-40" style="border-color: var(--kelpi-border, #24242B); color: var(--kelpi-fg-secondary, #9A9AA0); background: transparent;">Close</button></span></div><div class="flex min-h-0 flex-1"><div role="tablist" aria-label="Settings sections" aria-orientation="vertical" data-testid="settings-tabs" class="flex w-44 shrink-0 flex-col gap-1 border-r p-2" style="border-color: var(--kelpi-border, #24242B); background: var(--kelpi-sidebar-bg, #0C0C10);"><button type="button" role="tab" id="settings-tab-general" aria-selected="false" aria-controls="settings-panel-general" tabindex="-1" data-testid="settings-tab-button-general" data-icon="gear" class="flex items-center gap-2 rounded px-2 py-1.5 text-left text-[12px] transition-colors duration-100" style="background: transparent; color: var(--kelpi-