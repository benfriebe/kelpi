+// A JS selection uses buffer row indices, which change when PageList prunes history.
+// Track its endpoints natively for the duration of a write, then consume their new
+// positions. The JS selection remains the authority outside that synchronous write.
+fn clearTrackedSelection(wrapper: *TerminalWrapper) void {
+    inline for (.{ .primary, .alternate }) |key| {
+        if (wrapper.terminal.screens.get(key)) |screen| screen.clearSelection();
+    }
+}
+
+pub fn trackSelection(
+    ptr: ?*anyopaque,
+    start_x: c_int,
+    start_y: c_int,
+    end_x: c_int,
+    end_y: c_int,
+) callconv(.c) bool {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return false));
+    clearTrackedSelection(wrapper);
+    const screen = wrapper.terminal.screens.active;
+    const pages = &screen.pages;
+    if (start_x < 0 or end_x < 0 or start_y < 0 or end_y < 0) return false;
+    if (start_x >= pages.cols or end_x >= pages.cols) return false;
+    if (start_y >= pages.total_rows or end_y >= pages.total_rows) return false;
+    const start = pages.pin(.{ .screen = .{ .x = @intCast(start_x), .y = @intCast(start_y) } }) orelse return false;
+    const end = pages.pin(.{ .screen = .{ .x = @intCast(end_x), .y = @intCast(end_y) } }) orelse return false;
+    screen.select(Selection.init(start, end, false)) catch return false;
+    return true;
+}
+
+/// Writes start column/row, end column/row, in absolute buffer coordinates.
+/// False means an endpoint was removed, the screen switched, or the VT reset.
+/// Always releases the pins, including those on a screen that became inactive.
+pub fn readSelection(ptr: ?*anyopaque, out: [*]u32) callconv(.c) bool {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return false));
+    defer clearTrackedSelection(wrapper);
+    const screen = wrapper.terminal.screens.active;
+    const sel = screen.selection orelse return false;
+    const start = sel.start();
+    const end = sel.end();
+    if (start.garbage or end.garbage) return false;
+    const a = screen.pages.pointFromPin(.screen, start) orelse return false;
+    const b = screen.pages.pointFromPin(.screen, end) orelse return false;
+    out[0] = a.coord().x;
+    out[1] = a.coord().y;
+    out[2] = b.coord().x;
+    out[3] = b.coord().y;
+    return true;
+}
