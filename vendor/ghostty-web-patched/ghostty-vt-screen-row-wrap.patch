+/// Whether a row ANYWHERE in the buffer, history included, is the soft-wrap
+/// continuation of the row above it: `isRowWrapped` for a row addressed by its
+/// absolute screen index (0 = oldest history row, the numbering `trackSelection`
+/// and `readSelection` use), which is the only addressing that reaches history.
+///
+/// KELPI (#323): copying a selection joins soft-wrapped rows instead of putting
+/// a newline at every wrap point, and a selection can start in scrollback, where
+/// `isRowWrapped` (active area only) cannot see.
+pub fn isScreenRowWrapped(ptr: ?*anyopaque, y: c_int) callconv(.c) bool {
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return false));
+    const pages = &wrapper.terminal.screens.active.pages;
+    if (y < 0 or y >= pages.total_rows) return false;
+    const pin = pages.pin(.{ .screen = .{ .y = @intCast(y) } }) orelse return false;
+    return pin.rowAndCell().row.wrap_continuation;
+}
