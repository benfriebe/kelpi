+test "Terminal: eraseLine complete resets wrap linkage" {
+    // NEX (kelpi #165). Upstream has no test that reaches the BACKWARD half of
+    // the reset: "Terminal: eraseLine resets wrap" above erases row 0, which is
+    // never a continuation, so `cursorResetWrapFull`'s
+    // `if (!page_row.wrap_continuation) return;` takes the early exit and the
+    // `up(1)` arithmetic after it is never executed. These two tests erase a
+    // CONTINUATION row instead. They matter more than they look: the shipped
+    // artifact is built `ReleaseSmall`, which compiles the page integrity
+    // assertions out, so this suite (Debug, runtime safety on) is the only
+    // place the pointer work is checked at all.
+    const alloc = testing.allocator;
+    var t = try init(alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+
+    // "ABCDE123" at 5 columns: row 0 holds ABCDE and soft-wraps into row 1.
+    for ("ABCDE123") |c| try t.print(c);
+    {
+        const row0 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 0 } }).?;
+        const row1 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 1 } }).?;
+        try testing.expect(row0.row.wrap);
+        try testing.expect(row1.row.wrap_continuation);
+    }
+
+    // EL 2 on the continuation row. Upstream left BOTH flags standing here; we
+    // break both halves, so neither row believes it is part of the other and a
+    // later column reflow cannot glue them back together.
+    t.setCursorPos(2, 1);
+    t.eraseLine(.complete, false);
+    {
+        const row0 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 0 } }).?;
+        const row1 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 1 } }).?;
+        try testing.expect(!row0.row.wrap);
+        try testing.expect(!row1.row.wrap_continuation);
+    }
+}
+
+test "Terminal: eraseLine complete clears the previous row's spacer head" {
+    // NEX (kelpi #165). The other half of `cursorResetWrapFull`: a wide
+    // character that could not fit in the last column leaves a SPACER HEAD
+    // there and wraps the character itself onto the next row. Once the linkage
+    // is broken that head has no tail to point at, so it has to be cleared,
+    // exactly as `cursorResetWrap` clears the one on its own row.
+    const alloc = testing.allocator;
+    var t = try init(alloc, .{ .rows = 5, .cols = 10 });
+    defer t.deinit(alloc);
+
+    t.setCursorPos(1, 10);
+    try t.print(0x1F600); // Smiley face, two cells wide
+    {
+        const head = t.screens.active.pages.getCell(.{ .active = .{ .x = 9, .y = 0 } }).?;
+        const row1 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 1 } }).?;
+        try testing.expectEqual(Cell.Wide.spacer_head, head.cell.wide);
+        try testing.expect(row1.row.wrap_continuation);
+    }
+
+    t.setCursorPos(2, 1);
+    t.eraseLine(.complete, false);
+    {
+        const head = t.screens.active.pages.getCell(.{ .active = .{ .x = 9, .y = 0 } }).?;
+        const row0 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 0 } }).?;
+        const row1 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 1 } }).?;
+        try testing.expectEqual(Cell.Wide.narrow, head.cell.wide);
+        try testing.expect(!row0.row.wrap);
+        try testing.expect(!row1.row.wrap_continuation);
+    }
+}
+
+test "Terminal: eraseLine right leaves a continuation row's backward linkage alone" {
+    // NEX (kelpi #165). The deliberate NON-change, pinned so nobody "completes"
+    // the fix by extending it to EL 0. `CR` + `ESC[K` + rewrite is how a
+    // progress bar redraws the tail of a line it already printed; when that
+    // line soft-wrapped, the row it lands on is a continuation row, and
+    // breaking the backward linkage there tears the logical line for good on
+    // the next widen. See the note on `Screen.cursorResetWrapFull`.
+    const alloc = testing.allocator;
+    var t = try init(alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+
+    for ("ABCDE123") |c| try t.print(c);
+    t.setCursorPos(2, 1);
+    t.eraseLine(.right, false);
+    {
+        const row1 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 1 } }).?;
+        // Still the tail of row 0: the rewrite that follows belongs to that line.
+        try testing.expect(row1.row.wrap_continuation);
+    }
+}
