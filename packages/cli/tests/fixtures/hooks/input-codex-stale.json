{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nex event stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Nex.app/Contents/Helpers/nex event session-start --agent codex"
          }
        ]
      }
    ]
  }
}
