{
  "name": "@nex/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store/index.ts"
  },
  "types": "./src/index.ts",
  "bin": {
    "nexd": "./dist/nexd.js"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "watch": "node scripts/bundle.mjs --watch",
    "start": "node scripts/bundle.mjs && node dist/nexd.js start --foreground",
    "nexd": "node scripts/bundle.mjs && node dist/nexd.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@nex/core": "workspace:*",
    "@nex/protocol": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "hono": "^4.13.3",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2"
  }
}
