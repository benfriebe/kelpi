{
  "name": "@kelpi/shell",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Electron shell for New Kelpi: loads the daemon-served UI, adds native chrome.",
  "main": "dist/main.js",
  "productName": "Kelpi",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:web": "node scripts/web-smoke.mjs",
    "smoke:terminal": "node scripts/terminal-smoke.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@kelpi/core": "workspace:*",
    "@kelpi/daemon": "workspace:*",
    "@kelpi/protocol": "workspace:*",
    "update-electron-app": "^3.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@types/ws": "^8.18.1",
    "electron": "^43.0.0",
    "esbuild": "^0.27.0"
  }
}
